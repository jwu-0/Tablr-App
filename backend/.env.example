# Backend secrets. Copy to backend/.env (gitignored) for local development;
# in staging/production these come from the host's secret manager.
#
# EVERY name the backend reads is listed here. Values are always empty.
# Nothing in this file may ever be copied into apps/mobile.

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=local                  # local | staging | production
LOG_LEVEL=info

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=
# SECRET. Bypasses row-level security. Server only — never in the app.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET. Used to verify the JWTs the app sends.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# --- Database ----------------------------------------------------------------
# SECRET. Direct Postgres connection (service role).
DATABASE_URL=

# --- CORS --------------------------------------------------------------------
# Comma-separated explicit allowlist. Never "*".
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Swappable providers: "fake" until told otherwise ------------------------
VERIFICATION_PROVIDER=fake         # fake | sheerid
RESERVATION_DISPATCH=fake          # fake | email | partner_api
RECEIPT_VERIFIER=fake              # fake | ocr | manual
NOTIFICATION_PROVIDER=fake         # fake | expo_push

# --- Third-party (all SECRET, all unset until the real provider is wired) -----
VERIFICATION_API_KEY=
TRANSACTIONAL_EMAIL_API_KEY=
MAPS_API_KEY=
MODERATION_API_KEY=
ERROR_MONITORING_DSN=
EXPO_ACCESS_TOKEN=

# --- Verification fake -------------------------------------------------------
# Comma-separated email domains auto-approved by the fake verifier.
VERIFICATION_ALLOWLIST_DOMAINS=northeastern.edu,example.edu

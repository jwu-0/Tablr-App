# App environment. Copy to apps/mobile/.env.
#
# EVERYTHING HERE IS PUBLIC. `EXPO_PUBLIC_*` values are inlined into the
# JavaScript bundle and shipped to every device — anyone can read them.
# Never put a service-role key, database URL, or third-party secret in this
# file or in .env. Those live only in backend/.env.

# mock     — MSW intercepts every request. No backend, no Supabase, no secrets.
# local    — http://localhost:8000 (run `pnpm dev:backend`)
# staging  — set EXPO_PUBLIC_API_URL
EXPO_PUBLIC_API_MODE=mock
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase, used for AUTH ONLY. The anon key is public by design and is
# constrained by row-level security. Leave blank in mock mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
